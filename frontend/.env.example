# ==============================================================================
# FDS Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' inside the 'frontend' directory for local run.
# Do NOT commit the '.env' file with real credentials to Git.

# Backend REST API base endpoint URL
VITE_API_BASE_URL=http://localhost:8080/api

# Application display name
VITE_APP_NAME=FlavorsExpress

# Future Integrations (Placeholder Templates)
VITE_GOOGLE_MAPS_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_FIREBASE_CONFIG=
