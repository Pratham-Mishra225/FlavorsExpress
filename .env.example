# ==============================================================================
# FDS Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate the actual secrets for local run.
# Do NOT commit the '.env' file with real credentials to Git.

# Database URL (MySQL)
DB_URL=jdbc:mysql://localhost:3306/food_delivery_db?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# Database Authentication
DB_USERNAME=
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# Security (JWT)
# Generate a secure 512-bit Base64 HMAC-SHA key for production
JWT_SECRET=
# Validity duration in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Configuration
# Comma-separated list of allowed origin URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
